<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heute_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hintergrund"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/heute_titel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Schichten heute"
        android:textColor="#FFD400"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/heute_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:text="App einmal öffnen, dann erscheinen hier die Schichten."
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
