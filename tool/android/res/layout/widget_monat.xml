<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/monat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hintergrund">

    <ImageView
        android:id="@+id/monat_bild"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="Monatsübersicht der Schichten"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/monat_leer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="Monatsübersicht: App einmal öffnen, dann erscheint hier der Kalender."
        android:textColor="#FFD400"
        android:textSize="14sp" />
</FrameLayout>
